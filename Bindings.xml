<Bindings>
	<!-- 导航类：header 决定在按键设置里显示的分组（对应 BINDING_HEADER_MYNAV） -->
	<Binding name="MYNAV_UP" category="MyNavigate" header="MYNAV">MyNavigate:OnDirection("UP")</Binding>
	<Binding name="MYNAV_DOWN" category="MyNavigate">MyNavigate:OnDirection("DOWN")</Binding>
	<Binding name="MYNAV_LEFT" category="MyNavigate">MyNavigate:OnDirection("LEFT")</Binding>
	<Binding name="MYNAV_RIGHT" category="MyNavigate">MyNavigate:OnDirection("RIGHT")</Binding>
	<!-- 动作类：对应 BINDING_HEADER_MYNAVACT -->
	<Binding name="MYNAV_A" category="MyNavigate" header="MYNAVACT">MyNavigate:OnAction("A")</Binding>
	<Binding name="MYNAV_B" category="MyNavigate">MyNavigate:OnAction("B")</Binding>
	<Binding name="MYNAV_X" category="MyNavigate">MyNavigate:OnAction("X")</Binding>
	<Binding name="MYNAV_Y" category="MyNavigate">MyNavigate:OnAction("Y")</Binding>
	<!-- 滚动类：对应 BINDING_HEADER_MYNAVSCROLL，默认 PageUp / PageDown -->
	<Binding name="MYNAV_SCROLLUP" category="MyNavigate" header="MYNAVSCROLL">MyNavigate:OnScroll(-1)</Binding>
	<Binding name="MYNAV_SCROLLDOWN" category="MyNavigate">MyNavigate:OnScroll(1)</Binding>
</Bindings>
